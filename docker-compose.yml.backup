services:
  postgres:
    image: postgres:16
    container_name: sk-bazaarhub-postgres
    environment:
      POSTGRES_DB: bazaarhub
      POSTGRES_USER: bazaar_app
      POSTGRES_PASSWORD: local_dev_change_me
    ports:
      - "5432:5432"
    volumes:
      - bazaarhub_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U bazaar_app -d bazaarhub"]
      interval: 10s
      timeout: 5s
      retries: 10
volumes:
  bazaarhub_pgdata:
